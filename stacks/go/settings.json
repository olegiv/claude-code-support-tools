{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-go-toolchain.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-go-test.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Compiling",
      "Migrating",
      "Publishing",
      "Theming",
      "Caching",
      "Querying",
      "Templating",
      "Routing",
      "Rendering",
      "Validating",
      "Auditing",
      "Indexing",
      "Scheduling",
      "Embedding",
      "Scanning"
    ]
  }
}
